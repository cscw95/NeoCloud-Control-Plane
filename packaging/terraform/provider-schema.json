          "version": 0,
          "block": {
            "attributes": {
              "id": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              },
              "tenant_id": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "contract_id": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "blueprint_key": {
                "type": "string",
                "description_kind": "plain",
                "optional": true,
                "computed": true
              },
              "racks": {
