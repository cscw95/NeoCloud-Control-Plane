                "type": "string",
                "description_kind": "plain",
                "computed": true,
                "sensitive": true
              }
            },
            "description_kind": "plain",
            "description": "Managed Kubernetes cluster, F11 (POST /api/v1/nvke/clusters)."
          }
        },
        "neocloud_tenant": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              },
              "name": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "isolation_tier": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "status": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              }
            },
            "description_kind": "plain",
            "description": "Customer organisation (POST /api/v1/tenants)."
          }
        },
        "neocloud_token_key": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              },
              "tenant_id": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "name": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "key": {
                "type": "string",
                "description_kind": "plain",
                "computed": true,
                "sensitive": true
              },
              "prefix": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              }
            },
            "description_kind": "plain",
            "description": "Token-API key, F01 (POST /api/v1/token/keys); secret only at create."
          }
        },
        "neocloud_token_quota": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
