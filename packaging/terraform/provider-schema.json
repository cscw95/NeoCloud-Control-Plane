                "description_kind": "plain",
                "computed": true
              }
            },
            "description_kind": "plain",
            "description": "Bare-metal order (POST /api/v1/orders kind=new; destroy = kind=terminate)."
          }
        },
        "neocloud_contract": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {
                "type": "string",
                "description_kind": "plain",
