                "required": true
              },
              "unit_price": {
                "type": "number",
                "description_kind": "plain",
                "description": "KRW per rack-month",
                "required": true
              },
              "same_ib_zone": {
                "type": "bool",
                "description_kind": "plain",
                "optional": true
              },
              "sla_tier": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "activate": {
                "type": "bool",
                "description_kind": "plain",
                "optional": true
              },
              "status": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              },
              "end_date": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              },
              "currency": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              }
            },
            "description_kind": "plain",
            "description": "Reserved (committed) contract, F06 (POST /api/v1/contracts + /activate)."
