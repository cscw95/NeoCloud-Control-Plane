      "provider": {
        "version": 0,
        "block": {
          "attributes": {
            "base_url": {
              "type": "string",
              "description_kind": "plain",
              "description": "NOCP base URL (env NEOCLOUD_BASE_URL)",
              "optional": true
            },
            "token": {
              "type": "string",
              "description_kind": "plain",
              "description": "Bearer token (env NEOCLOUD_TOKEN)",
              "optional": true,
              "sensitive": true
            },
            "operator": {
              "type": "bool",
              "description_kind": "plain",
              "description": "send X-Operator (dev stacks only)",
              "optional": true
            }
          },
          "description_kind": "plain"
        }
      },
      "resource_schemas": {
