              "tenant_id": {
                "type": "string",
                "description_kind": "plain",
                "required": true
              },
              "tier": {
                "type": "string",
                "description_kind": "plain",
                "optional": true
              },
              "tpm": {
                "type": "number",
                "description_kind": "plain",
                "required": true
              },
              "rpm": {
                "type": "number",
                "description_kind": "plain",
                "required": true
              },
              "source": {
                "type": "string",
                "description_kind": "plain",
                "computed": true
              }
            },
            "description_kind": "plain",
            "description": "TPM/RPM quota per tier, F02 (PUT /api/v1/token/quotas/{tenant_id})."
          }
        }
      },
      "data_source_schemas": {}
    }
