{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neocloud.example/schemas/leak-response.v1.json",
  "title": "NeoCloud leak response (F22)",
  "x-neocloud": true,
  "description": "NeoCloud extension. DSX Exchange mission-control/leak-response.yaml is an empty upstream file (dsx-exchange@3358e108d9ad), so this record is NeoCloud-defined. healthEvent uses NVSentinel HealthEvent proto field names (NVIDIA/NVSentinel@7ce200c634fd data-models/protobufs/health_event.proto).",
  "type": "object",
  "required": ["id", "event_id", "tray_id", "rack", "machine_id", "severity", "detected_at", "health_event", "steps", "kind", "state", "kpi_s"],
  "properties": {
    "id": {"type": "string", "pattern": "^leak-[0-9]{4,}$"},
    "event_id": {"type": "string"},
    "tray_id": {"type": "string"},
    "rack": {"type": "string"},
    "machine_id": {"type": "string"},
    "severity": {"type": "string", "enum": ["Warning", "Critical"]},
    "detected_at": {"type": "string"},
    "kind": {"type": "string", "enum": ["nvke", "bmaas", "idle", "notice-only"]},
    "state": {"type": "string", "enum": ["open", "moved", "awaiting-customer", "cordoned", "done"]},
    "tenant_id": {"type": ["string", "null"]},
    "cluster_id": {"type": ["string", "null"]},
    "remediation_run_id": {"type": ["string", "null"]},
    "ticket_id": {"type": ["string", "null"]},
    "kpi_s": {"type": "integer"},
    "elapsed_s": {"type": "number"},
    "within_kpi": {"type": "boolean"},
    "steps": {"type": "array", "items": {"type": "object", "required": ["name", "state", "at"],
      "properties": {"name": {"type": "string", "enum": ["health-event", "cordon", "drain", "replace", "remediation-run", "ticket", "notice"]},
                     "state": {"type": "string", "enum": ["done", "failed"]}, "at": {"type": "string"}}}},
    "health_event": {"type": "object",
      "required": ["version", "agent", "componentClass", "checkName", "isFatal", "isHealthy", "message", "recommendedAction", "entitiesImpacted", "generatedTimestamp", "nodeName"],
      "properties": {"componentClass": {"type": "string", "enum": ["Tray", "Chassis"]},
                     "recommendedAction": {"type": "string", "enum": ["NONE", "COMPONENT_RESET", "CONTACT_SUPPORT", "RUN_FIELDDIAG", "RESTART_VM", "RESTART_BM", "REPLACE_VM", "RUN_DCGMEUD", "CUSTOM", "UNKNOWN"]},
                     "entitiesImpacted": {"type": "array", "items": {"type": "object", "required": ["entityType", "entityValue"]}}}}
  }
}
