{"$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "JWK Set (RFC 7517 §5) with RSA public keys (RFC 7518 §6.3.1)",
 "source": "https://www.rfc-editor.org/rfc/rfc7517",
 "type": "object", "required": ["keys"],
 "properties": {"keys": {"type": "array", "items": {
   "type": "object", "required": ["kty", "kid", "n", "e"],
   "properties": {"kty": {"const": "RSA"}, "kid": {"type": "string"},
                  "alg": {"const": "RS256"}, "use": {"const": "sig"},
                  "n": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
                  "e": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}}}}}
